# คัดลอกเป็น .env (ห้าม commit .env) — Production ให้ดึงจาก Secret Manager / Vault แทน
PROC_ENVIRONMENT=development
PROC_DATABASE_URL=postgresql+psycopg://proc:CHANGE_ME@localhost:5432/procurement
PROC_ALLOWED_ORIGINS=["http://localhost:5173"]

# สร้างด้วย: python -c "import secrets;print(secrets.token_urlsafe(48))"
PROC_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS________________
PROC_BLIND_INDEX_KEY=CHANGE_ME_AT_LEAST_32_CHARS________________

# สร้างด้วย: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PROC_DATA_KEYS={"k1": "CHANGE_ME_BASE64_32_BYTES"}
PROC_ACTIVE_DATA_KEY_ID=k1
PROC_BACKUP_KEY=CHANGE_ME_BASE64_32_BYTES

# LINE Messaging API (LINE Developers Console → Messaging API → Channel access token)
PROC_LINE_CHANNEL_ACCESS_TOKEN=
PROC_PUBLIC_BASE_URL=https://procurement.example.go.th
